# ============================================================================
# AgroCenter Digital - variables para Docker Compose (EC2 / local)
# Copiar a .env y ajustar los valores antes de desplegar:
#   cp .env.example .env
# ============================================================================

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=db_inventario
POSTGRES_PORT=5432
DB_HOST=postgres
DB_PORT=5432

# --- Spring Boot ------------------------------------------------------------
# prod: valida JWT contra AWS Cognito (recomendado en EC2)
# dev:  usa tokens HS256 locales (requiere DEV_JWT_SECRET de 32+ caracteres)
SPRING_PROFILES_ACTIVE=prod
SWAGGER_ENABLED=false
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# --- Puertos publicados en el host -----------------------------------------
BFF_PORT=8080
INVENTARIO_PORT=8081
VENTAS_PORT=8082
COMPRAS_PORT=8083
# El frontend Nginx se publica en el puerto 3000 del host EC2
FRONTEND_PORT=3000

# --- Kafka (KRaft) ----------------------------------------------------------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- URLs internas (DNS de la red Docker) -----------------------------------
INVENTORY_SERVICE_URL=http://ms-inventario:8081
SALES_SERVICE_URL=http://ms-ventas:8082
PURCHASES_SERVICE_URL=http://ms-compras:8083

# --- AWS Cognito ------------------------------------------------------------
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_DBCBjL67J
COGNITO_JWK_SET_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_DBCBjL67J/.well-known/jwks.json
COGNITO_AUDIENCE=agrocenter-api

# --- JWT de desarrollo (solo si SPRING_PROFILES_ACTIVE=dev) -----------------
DEV_JWT_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
DEV_JWT_ISSUER=http://localhost:8081/dev-issuer
DEV_JWT_TTL_SECONDS=3600

# --- CORS del BFF ------------------------------------------------------------
# Orígenes que pueden llamar directamente al BFF. En el panel EC2 las llamadas
# son same-origin vía Nginx (/api), pero se mantienen los orígenes de Vercel y
# de ambas EC2 para handoffs y diagnóstico.
ALLOWED_ORIGINS=https://front-web-seven.vercel.app,http://44.195.118.58:3000,http://34.195.64.174:3000,http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1
ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app

# --- Front-web (Nginx estático: vacío = rutas relativas /api/...) -----------
# Dejar vacío para que Nginx proxye internamente. Solo definir si se usa una URL externa.
NEXT_PUBLIC_API_BASE_URL=
# URL pública del frontend (IP elástica o dominio de la EC2). Se usa para
# metadata/Open Graph en el export estático; no afecta las llamadas /api.
NEXT_PUBLIC_SITE_URL=http://34.195.64.174:3000

# --- Cognito (solo si el panel inicia login localmente; el flujo normal es handoff) ---
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=

# --- Fallback de JWT SOLO para desarrollo local ------------------------------
# En producción debe quedar vacío: cualquier valor se inlinea en el bundle.
NEXT_PUBLIC_DEV_JWT_FALLBACK_TOKEN=

# --- Reglas de negocio ------------------------------------------------------
KAFKA_TOPICS=ordenes-compras,inventario-critico
CATALOG_QUOTE_ONLY_SKUS=
COMPRAS_AUTO_PROVEEDOR_ID=1
